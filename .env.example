# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA vai para o Git (está no .gitignore). Este arquivo (.env.example) vai,
# por isso aqui só existem valores falsos.

# Connection string do Supabase (Session pooler, porta 5432).
# Onde achar: Supabase → botão "Connect" → connection string → Session pooler.
# Troque SUA_SENHA pela senha do banco (sem colchetes). Se a senha tiver caracteres
# especiais (@ : / ? # % etc.), eles precisam ser codificados (ex.: @ vira %40).
# ?sslmode=require obriga a conexão a ser criptografada.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Chave da API do Claude (console.anthropic.com → API Keys).
# O SDK anthropic lê esta variável automaticamente, com exatamente este nome.
# Enquanto a chave não chegar, deixe o valor falso: o teste pula a parte do Claude.
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui
